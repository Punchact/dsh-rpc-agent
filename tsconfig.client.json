{
  "compilerOptions": {
    "target": "es2023",
    "module": "none",
    "lib": ["es2023", "dom"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": []
  },
  "include": ["client.js"]
}
