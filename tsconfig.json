{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "checkJs": false,
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": false,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": false,
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
