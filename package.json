{
  "name": "@punchact/dsh-rpc-agent",
  "version": "0.4.0",
  "description": "Loopback JSON-RPC bridge that lets local AI agents drive DeepSeek Harness sessions",
  "author": "Punchact",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Punchact/dsh-rpc-agent.git"
  },
  "homepage": "https://github.com/Punchact/dsh-rpc-agent#readme",
  "bugs": {
    "url": "https://github.com/Punchact/dsh-rpc-agent/issues"
  },
  "private": true,
  "type": "module",
  "main": "index.mjs",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./http-client": "./lib/client.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "client.js",
    "lib/",
    "bin/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/",
    "test/"
  ],
  "bin": {
    "dsh-rpc": "./bin/dsh-rpc.mjs",
    "dsh-rpc-mcp": "./bin/dsh-rpc-mcp.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node test/methods.test.mjs && node test/client.test.mjs && node test/status.test.mjs && node test/catalog.smoke.mjs",
    "test:host": "node test/host.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:edge": "node test/edge.mjs",
    "check:version": "node --input-type=module -e \"import {readFileSync} from 'node:fs'; const {PLUGIN_VERSION} = await import('./lib/version.mjs'); const v = JSON.parse(readFileSync('package.json','utf8')).version; if (PLUGIN_VERSION !== v) { console.error('PLUGIN_VERSION ' + PLUGIN_VERSION + ' != package.json ' + v); process.exit(1); } console.log('version ok: ' + v);\""
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "json-rpc",
    "mcp",
    "agent-bridge"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5"
  }
}
